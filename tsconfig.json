    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "rootDir": ".",
    "types": ["node"],
    "outDir": "./dist"
  },
  "include": ["./src/**/*.ts", "discord-env.example.ts", "./declarations.d.ts"],
  "exclude": ["./initialize.js", "./dist/**/*"]
}
