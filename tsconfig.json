{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "rootDir": ".",
    "types": ["node"],
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "types": ["./src/types"],
      "modules/*": ["./src/modules/*"]
    }
  },
  "include": ["./src/**/*.ts", "discord-env.example.ts", "./declarations.d.ts"],
  "exclude": ["./initialize.js", "./dist/**/*"]
}
